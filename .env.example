# App
APP_ENV=development                 # development | production | test
SECRET_KEY=change-me-64-random-bytes
API_PREFIX=/api
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO
UVICORN_WORKERS=2
OPENAPI_ENABLED=true                # set false to disable /api/docs and /api/openapi.json

# Database
POSTGRES_USER=jsonviewer
POSTGRES_PASSWORD=jsonviewer
POSTGRES_DB=jsonviewer
DATABASE_URL=postgresql+asyncpg://jsonviewer:jsonviewer@db:5432/jsonviewer
DB_POOL_SIZE=10

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# OAuth (a provider with an empty client id or secret is disabled)
OAUTH_REDIRECT_BASE_URL=http://localhost:3000/api/auth   # callback = {base}/{provider}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Sessions
SESSION_COOKIE_NAME=jv_session
SESSION_TTL_DAYS=30
COOKIE_SECURE=false                 # true in production

# Limits
MAX_DOCUMENT_BYTES=15728640         # 15 MB, for shares / history / analysis
MAX_FETCH_BYTES=15728640            # 15 MB, for remote fetch
FETCH_TIMEOUT_SECONDS=10
FETCH_MAX_REDIRECTS=3
HISTORY_MAX_ENTRIES_PER_USER=500
RATE_LIMIT_STORE=memory             # memory | redis
REDIS_URL=                          # required only if RATE_LIMIT_STORE=redis
